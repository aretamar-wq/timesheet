# Copiar como .env y completar. El archivo .env NO se versiona (tiene contraseñas).

# --- Servidor ---
# El backend escucha solo en localhost: nginx es el único que le habla.
HOST=127.0.0.1
PORT=3000
# production | development
NODE_ENV=production
# Zona horaria para "hoy" (semana actual, mes actual del reporte).
TZ=America/Argentina/Buenos_Aires

# Nombre del sistema: login, barra superior y título de la pestaña.
APP_NOMBRE=Cocos Bank Timesheet

# --- Base de datos (MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=timesheet
DB_USER=timesheet_app
DB_PASSWORD=CAMBIAR_ESTA_CLAVE

# --- Sesión ---
# Secreto para firmar la cookie de sesión. Generar uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESION_SECRETO=
# Duración de la sesión en horas (se renueva sola mientras se usa).
SESION_HORAS=8
# true cuando el sitio se sirve por HTTPS (la cookie solo viaja cifrada). Obligatorio en producción.
COOKIE_SEGURA=false

# --- Active Directory ---
# real | simulado. "simulado" acepta cualquier contraseña: SOLO para desarrollo (se rechaza con NODE_ENV=production).
AD_MODO=real
AD_DOMINIO=bv.voii.com.ar
# ldaps://...:636 (recomendado) o ldap://...:389 con AD_STARTTLS=true. Con ldap:// sin STARTTLS la contraseña viaja en claro.
AD_URL=ldap://bv.voii.com.ar:389
AD_STARTTLS=true
# false solo si el certificado del controlador de dominio no es de confianza para el servidor (no recomendado).
AD_TLS_VERIFICAR=true
# Si se deja vacío se arma a partir del dominio (DC=bv,DC=voii,DC=com,DC=ar).
AD_BASE_DN=
# Cuenta de servicio (solo lectura) para buscar usuarios en AD: la usan el ABM de Usuarios ("Verificar en AD")
# y el login. Formato usuario@dominio. En Linux no hay cuenta de máquina del dominio, por eso hace falta.
AD_BIND_USUARIO=
AD_BIND_PASSWORD=
